# Copy to .env for local runs. Nothing here is required: the deterministic
# pipeline runs with no credentials at all.

# Optional AI enrichment (config.yaml -> ai.enabled must also be true).
# GEI_AI_ENABLED=true
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# Optional alert channels (config.yaml -> alerts.channels).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SLACK_WEBHOOK_URL=
# DISCORD_WEBHOOK_URL=
